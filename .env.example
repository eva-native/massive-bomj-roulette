# Copy to .env and fill in. See docs/dev/README.md.

# Public URL of the app. Discord redirects to $MBR_BASE_URL/auth/discord/callback.
MBR_BASE_URL=http://localhost:8080

# Local dev database from `docker compose up -d db`.
MBR_DATABASE_URL=postgres://mbr:mbr@localhost:5433/mbr?sslmode=disable

# Discord application (https://discord.com/developers/applications → OAuth2).
MBR_DISCORD_CLIENT_ID=
MBR_DISCORD_CLIENT_SECRET=

# Discord user IDs that may create events, comma separated. Dev users are "dev:<name in lower case>".
MBR_ADMIN_DISCORD_IDS=dev:admin

# Log in as any name without Discord. Development only!
MBR_DEV_LOGIN=true
